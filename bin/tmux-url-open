#!/usr/bin/env bash
# Copy a URL into the tmux paste buffer and the terminal clipboard.
# tmux-url-open [--client CLIENT] [--line N --buffer NAME] [--] [URL]
set -euo pipefail

client=""
line=""
buffer=""
url=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --client)
      client="${2:-}"
      shift 2
      ;;
    --line)
      line="${2:-}"
      shift 2
      ;;
    --buffer)
      buffer="${2:-}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "tmux-url-open: unknown option $1" >&2
      exit 2
      ;;
    *)
      url="$1"
      shift
      ;;
  esac
done
if [[ -z "$url" && $# -gt 0 ]]; then
  url="$1"
fi

if [[ -n "$line" ]]; then
  if [[ -z "$buffer" ]]; then
    echo "tmux-url-open: --line needs --buffer" >&2
    exit 2
  fi
  url="$(tmux show-buffer -b "$buffer" | awk -v n="$line" 'NR == n { print; exit }')"
fi

if [[ -z "$url" ]]; then
  exit 0
fi

# Paste buffer for prefix + ]. Argument is not format-expanded.
tmux set-buffer -- "$url"

# -w asks tmux to emit OSC 52 on the attached client. Writing the sequence to
# the pane tty never reaches that client: tmux owns the pane pty.
if [[ -n "$client" ]]; then
  tmux set-buffer -w -t "$client" -- "$url" 2>/dev/null || true
else
  tmux set-buffer -w -- "$url" 2>/dev/null || true
fi

text="copied: ${url//#/##}"
if [[ -n "$client" ]]; then
  tmux display-message -c "$client" -- "$text" 2>/dev/null || true
else
  tmux display-message -- "$text" 2>/dev/null || true
fi
